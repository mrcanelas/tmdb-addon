{
  "name": "tmdb-addon",
  "version": "3.1.7",
  "description": "MetaLayer monorepo (legacy package name retained during migration)",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm -F core -F server -F frontend --parallel dev",
    "dev:core": "pnpm -F core dev",
    "dev:server": "pnpm -F server dev",
    "dev:frontend": "pnpm -F frontend dev",
    "dev:dashboard": "pnpm -F dashboard dev",
    "build": "pnpm build:frontend && pnpm build:server && pnpm -F dashboard --if-present build",
    "build:frontend": "pnpm -F frontend build",
    "build:server": "pnpm -F server build",
    "build:dashboard": "pnpm -F dashboard --if-present build",
    "lint": "eslint .",
    "preview:frontend": "pnpm -F frontend preview",
    "start": "pnpm -F server start",
    "start:server": "pnpm -F server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run apps/server/src/performance.harness.test.ts",
    "typecheck": "pnpm -F \"./packages/**\" -F \"./apps/**\" -r --if-present typecheck",
    "i18n:check": "pnpm -F @metalayer/i18n i18n:check",
    "i18n:pseudo": "pnpm -F @metalayer/i18n i18n:pseudo",
    "metalayer:upgrade-check": "node ./scripts/metalayer-upgrade-check.mjs",
    "metalayer:vault-reencrypt": "pnpm -F @metalayer/server exec tsx ../../scripts/metalayer-vault-reencrypt.ts",
    "metalayer:tracking-refresh": "pnpm -F @metalayer/server exec tsx ../../scripts/metalayer-tracking-refresh.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcanelas/tmdb-addon"
  },
  "keywords": [
    "metalayer",
    "stremio",
    "tmdb",
    "metadata"
  ],
  "author": "mrcanelas",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mrcanelas/tmdb-addon/issues"
  },
  "homepage": "https://github.com/mrcanelas/tmdb-addon#readme",
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vitest": "^3.0.9"
  }
}
