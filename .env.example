# Required
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true
MONGODB_METRICS=mongodb+srv://username:password@cluster.mongodb.net/metrics?retryWrites=true
FANART_API=your_fanart_api_key_here

# TMDB_API is Optional - Users can provide their own TMDB API key via the web interface
# TMDB_API=your_tmdb_api_key_here

# Trakt OAuth integration (optional)
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
# Optional override; configure UI defaults to {origin}/configure/oauth/trakt/callback
# TRAKT_REDIRECT_URI=http://localhost:1338/configure/oauth/trakt/callback

SIMKL_CLIENT_ID=your_simkl_client_id_here
SIMKL_CLIENT_SECRET=your_simkl_client_secret_here
# Optional override; configure UI defaults to {origin}/configure/oauth/simkl/callback
# SIMKL_REDIRECT_URI=http://localhost:1338/configure/oauth/simkl/callback

HOST_NAME=http://localhost:1337

# Server settings
PORT=1337
NODE_ENV=production

# Analytics Configuration
METRICS_USER=admin
METRICS_PASSWORD=your_secure_password_here

# Optional shared cache (Redis)
# REDIS_URL=redis://username:password@host:port

# Optional Postgres (MetaLayer Server / future persistence)
# POSTGRES_URL=postgresql://user:password@host:5432/metalayer?sslmode=require

# MetaLayer API (Phase B)
METALAYER_API_PORT=1338
# 32-byte key as base64 or 64-char hex — never commit real values
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset in local dev, apps/api writes data/.metalayer-dev-encryption-key automatically
METALAYER_ENCRYPTION_KEY=
# SQLite path for Lite persistence (use :memory: only for tests)
METALAYER_SQLITE_PATH=./data/metalayer.sqlite

# Optional encryption / session secrets (legacy / extras)
# JWT_SECRET=replace_with_long_random_secret

# Optional email (operator notifications)
# EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=re_xxxxxxxx

# GitHub (optional operator integrations)
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=

# Proxy Settings (optional)
# Enable proxy to bypass regional blocks
TMDB_PROXY_ENABLED=false

# Proxy configuration
TMDB_PROXY_HOST=127.0.0.1
TMDB_PROXY_PORT=1080
TMDB_PROXY_PROTOCOL=http

# Proxy authentication (optional)
TMDB_PROXY_AUTH=false
TMDB_PROXY_USERNAME=proxy_username
TMDB_PROXY_PASSWORD=proxy_password

# Cache limits (optional)
# Main cache-manager memory store cap (used when Redis is disabled)
MEMORY_CACHE_MAX_KEYS=5000

# Dedicated in-process RAM caches (bounded by max keys)
RAM_META_TTL=3600
RAM_META_MAX_KEYS=2000
RAM_IMDB_TTL=86400
RAM_IMDB_MAX_KEYS=5000
RAM_AGE_RATING_TTL=3600
RAM_AGE_RATING_MAX_KEYS=5000
RAM_USER_COUNTER_TTL=86400
RAM_USER_COUNTER_MAX_KEYS=100000

# Telemetry (disabled by default for self-hosted)
METALAYER_TELEMETRY_ENABLED=false

# Operator dashboard (required for /api/v1/dashboard/*)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
METALAYER_DASHBOARD_TOKEN=

# Deployment profile: lite | server (auto-detected from REDIS_URL/POSTGRES_URL when unset)
# METALAYER_DEPLOYMENT_MODE=lite

