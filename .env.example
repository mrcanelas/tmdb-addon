# Annotated for Admin-first instance config (ADR 0008 / docs/deployment.md):
#   bootstrap       = must stay in env (chicken-egg / process)
#   admin-candidate = prefer Dashboard Admin Providers/Settings once UI lands (env still works)
#   per-config      = end-user Configure secrets (never put here)

# admin-candidate — Fanart.tv instance API key (Admin → Providers)
FANART_API=your_fanart_api_key_here

# admin-candidate optional instance default; users may also supply TMDB API key per config (per-config)
# TMDB_API=your_tmdb_api_key_here

# admin-candidate — OAuth *app* credentials (Admin → Providers). Without these, Tracking OAuth is unavailable in Configure.
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
# Optional override; configure UI defaults to {origin}/configure/oauth/trakt/callback
# TRAKT_REDIRECT_URI=http://localhost:1338/configure/oauth/trakt/callback

SIMKL_CLIENT_ID=your_simkl_client_id_here
SIMKL_CLIENT_SECRET=your_simkl_client_secret_here
# Optional override; configure UI defaults to {origin}/configure/oauth/simkl/callback
# SIMKL_REDIRECT_URI=http://localhost:1338/configure/oauth/simkl/callback

ANILIST_CLIENT_ID=your_anilist_client_id_here
ANILIST_CLIENT_SECRET=your_anilist_client_secret_here
# Optional override; configure UI defaults to {origin}/configure/oauth/anilist/callback
# ANILIST_REDIRECT_URI=http://localhost:1338/configure/oauth/anilist/callback

MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
# Optional override; configure UI defaults to {origin}/configure/oauth/mal/callback
# MAL_REDIRECT_URI=http://localhost:1338/configure/oauth/mal/callback

# bootstrap — public hostname / origin hints
HOST_NAME=http://localhost:1338
NODE_ENV=production

# admin-candidate — shared cache (Admin → Settings; env accepted until UI lands)
# REDIS_URL=redis://username:password@host:port

# admin-candidate — Postgres Server persistence (Admin → Settings; restart-declared)
# POSTGRES_URL=postgresql://user:password@host:5432/metalayer?sslmode=require

# MetaLayer API
# bootstrap
METALAYER_API_PORT=1338
# bootstrap — 32-byte key as base64 or 64-char hex — never commit real values
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset in local dev, apps/server writes data/.metalayer-dev-encryption-key automatically
METALAYER_ENCRYPTION_KEY=
# Active key version written on new vault envelopes (default 1)
# METALAYER_ENCRYPTION_KEY_VERSION=1
# Previous keys still needed to decrypt older envelopes during rotation:
# METALAYER_ENCRYPTION_PREVIOUS_KEYS=1:<base64-or-hex>
# After rotation: pnpm metalayer:vault-reencrypt --dry-run && pnpm metalayer:vault-reencrypt
# bootstrap — SQLite path for Lite persistence (use :memory: only for tests)
METALAYER_SQLITE_PATH=./data/metalayer.sqlite

# bootstrap — operator dashboard token
# METALAYER_DASHBOARD_TOKEN=replace_with_long_random_token

# Optional email (operator notifications)
# EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=re_xxxxxxxx

# GitHub (optional operator integrations)
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=

# admin-candidate — TMDB proxy (Admin → Settings)
# See docs/deployment.md

# Telemetry (disabled by default)
METALAYER_TELEMETRY_ENABLED=false

# Optional Jikan base URL for MAL adapter
# METALAYER_JIKAN_URL=https://api.jikan.moe/v4
